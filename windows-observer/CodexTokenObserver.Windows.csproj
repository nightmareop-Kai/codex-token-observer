<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CodexTokenObserver</AssemblyName>
    <RootNamespace>TokenObserver</RootNamespace>
    <Version>0.3.0</Version>
    <Title>Zuno</Title>
    <Product>Zuno</Product>
    <Description>A quiet desktop companion for local Codex token usage.</Description>
    <ApplicationIcon>../assets/branding/Zuno.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src/windows-observer</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../assets/branding/Zuno.ico" Link="Resources/Zuno.ico" />
  </ItemGroup>
</Project>
